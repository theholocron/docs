auto-install-peers=true
strict-peer-dependencies=false
# Hoist @astrojs/react to root node_modules so Astro's virtual renderer can resolve
# @astrojs/react/server.js at build time. It's a dep of @theholocron/astro-config
# (not a direct dep here), so pnpm won't symlink it at root without this.
public-hoist-pattern[]=@astrojs/react

---
import {
	getClients,
	getConfigs,
	getDocs,
	getPlugins,
	getSkills,
	getThemes,
	getUtils,
} from "@theholocron/registry-doc";
import PackageGrid from "../package-grid/package-grid.astro";
import type { RepoIndexProps } from "./types.ts";

type Props = RepoIndexProps;

const { type } = Astro.props;

const registryMap = {
	clients: { packages: getClients(), gridType: "packages" as const },
	configs: { packages: getConfigs(), gridType: "packages" as const },
	docs: { packages: getDocs(), gridType: "packages" as const },
	plugins: { packages: getPlugins(), gridType: "plugins" as const },
	skills: { packages: getSkills(), gridType: "packages" as const },
	themes: { packages: getThemes(), gridType: "packages" as const },
	utils: { packages: getUtils(), gridType: "packages" as const },
};

const { packages, gridType } = registryMap[type];
---

<PackageGrid packages={packages} type={gridType} />

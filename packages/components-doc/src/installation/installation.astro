---
import type { InstallationProps } from "./types.ts";

type Props = InstallationProps;

const { package: pkg, dev = false, global: isGlobal = false } = Astro.props;
const flag = isGlobal ? " -g" : dev ? " -D" : "";
const command = `pnpm add${flag} ${pkg}`;
---

<h2>Install</h2>
<pre><code>{command}</code></pre>

{
  "name": "@theholocron/registry-doc",
  "version": "1.2.0",
  "description": "Cross-repo package registry and link utilities for docs.",
  "homepage": "https://docs.theholocron.dev/docs/registry-doc",
  "bugs": "https://github.com/theholocron/docs/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theholocron/docs.git"
  },
  "license": "GPL-3.0",
  "author": "Newton Koumantzelis",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./validate": {
      "import": "./dist/validate.mjs",
      "default": "./dist/validate.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codecov/rollup-plugin": "^2.0.1",
    "@theholocron/eslint-config": "catalog:configs",
    "@theholocron/prettier-config": "catalog:configs",
    "@theholocron/tsconfig": "catalog:configs",
    "@theholocron/tsdown-config": "catalog:configs",
    "@theholocron/vitest-config": "catalog:configs",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "prettier": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./validate": {
        "types": "./dist/validate.d.mts",
        "import": "./dist/validate.mjs",
        "default": "./dist/validate.mjs"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.mts"
  },
  "releases": "https://github.com/theholocron/docs/releases",
  "wiki": "https://github.com/theholocron/docs/wiki"
}
